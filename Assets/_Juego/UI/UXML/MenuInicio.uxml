<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="../USS/FantasyTheme.uss" />

    <ui:VisualElement name="root" class="fondo-aventura">

        <!-- Capas decorativas de fondo -->
        <ui:VisualElement class="fondo-overlay" />
        <ui:VisualElement class="franja-superior" />
        <ui:VisualElement class="franja-inferior" />

        <!-- Contenedor principal — tablero de madera -->
        <ui:VisualElement name="center-wrap" class="tablero-menu" style="width: 380px; align-items: center;">

            <!-- Pernos metálicos -->
            <ui:VisualElement class="bolt-tl" />
            <ui:VisualElement class="bolt-tr" />
            <ui:VisualElement class="bolt-bl" />
            <ui:VisualElement class="bolt-br" />

            <!-- Título -->
            <ui:Label name="title-label" text="RUTA AMORFA" class="titulo-juego" />
            <ui:Label name="subtitle-label" text="JUEGO DE MESA" class="texto-secundario"
                style="-unity-text-align: middle-center; margin-bottom: 30px; letter-spacing: 3px;" />

            <!-- Botones -->
            <ui:Button name="btn-jugar"    text="JUGAR"    class="btn btn-primario"
                style="align-self: stretch;" />
            <ui:Button name="btn-opciones" text="OPCIONES" class="btn"
                style="align-self: stretch;" />
            <ui:Button name="btn-salir"    text="SALIR"    class="btn btn-destructivo"
                style="align-self: stretch; margin-bottom: 0;" />

        </ui:VisualElement>

        <!-- Versión -->
        <ui:Label name="version-label" text="v0.3  •  Alpha" class="texto-secundario"
            style="-unity-text-align: middle-center; margin-top: 16px;" />

        <!-- Panel de Opciones — nombre del jugador -->
        <ui:VisualElement name="panel-opciones" class="panel-oculto overlay-aviso">
            <ui:VisualElement class="tablero-menu grupo-contenido">
                <ui:Label text="NOMBRE DEL JUGADOR" class="titulo-panel" />
                <ui:TextField name="input-nombre" max-length="16" class="input-campo" />
                <ui:Button name="btn-guardar-nombre" text="GUARDAR" class="btn btn-primario" />
                <ui:Button name="btn-cerrar-opciones" text="CERRAR" class="btn" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
