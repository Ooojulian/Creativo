<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/FantasyTheme.uss" />

    <!-- Panel de revelación de carta (centrado, aparece sobre el juego) -->
    <ui:VisualElement name="carta-reveal-root" style="
        position: absolute; top: 0; left: 0; right: 0; bottom: 0;
        align-items: center; justify-content: center;
        background-color: rgba(0,0,0,0.5);">

        <ui:VisualElement name="carta-panel" class="panel" style="
            width: 300px; align-items: center; padding: 28px 32px;">

            <!-- Encabezado -->
            <ui:Label name="carta-titulo" text="CARTA REVELADA" class="text-dim"
                style="font-size: 11px; letter-spacing: 3px; margin-bottom: 12px;" />

            <!-- Imagen / placeholder -->
            <ui:VisualElement name="carta-imagen-container" style="
                width: 140px; height: 200px;
                background-color: #221b38;
                border-color: #7a5c1e; border-width: 2px;
                border-radius: 8px;
                align-items: center; justify-content: center;
                margin-bottom: 16px;">
                <ui:Label name="carta-emoji" text="🃏"
                    style="font-size: 56px; -unity-text-align: middle-center;" />
                <ui:VisualElement name="carta-imagen" style="
                    position: absolute; top: 0; left: 0; right: 0; bottom: 0;" />
            </ui:VisualElement>

            <!-- Nombre de la carta -->
            <ui:Label name="carta-nombre" text="Nombre de Carta" class="card-title-text" />

            <!-- Descripción / estado -->
            <ui:Label name="carta-estado" text="" class="card-desc-text" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
