<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/FantasyTheme.uss" />

    <!-- Lobby Photon (crear sala / unirse / esperar) -->
    <ui:VisualElement name="lobby-root" class="fondo-aventura">

        <!-- Capas decorativas de fondo -->
        <ui:VisualElement class="fondo-overlay" />
        <ui:VisualElement class="franja-superior" />
        <ui:VisualElement class="franja-inferior" />

        <!-- Panel principal del menú -->
        <ui:VisualElement name="panel-menu" class="tablero-menu" style="width: 440px; align-items: center;">

            <!-- Pernos metálicos -->
            <ui:VisualElement class="bolt-tl" />
            <ui:VisualElement class="bolt-tr" />
            <ui:VisualElement class="bolt-bl" />
            <ui:VisualElement class="bolt-br" />

            <ui:Label text="SALA DE JUEGO" class="titulo-panel" />

            <ui:Button name="btn-crear"        text="✦ CREAR SALA"        class="btn btn-primario"
                style="align-self: stretch;" />
            <ui:Button name="btn-unirse-panel" text="◆ UNIRSE CON CÓDIGO" class="btn"
                style="align-self: stretch;" />
            <ui:Button name="btn-volver"       text="VOLVER"              class="btn btn-destructivo"
                style="align-self: stretch; margin-bottom: 0;" />

        </ui:VisualElement>

        <!-- Panel para ingresar código -->
        <ui:VisualElement name="panel-unirse" class="tablero-menu"
            style="width: 440px; align-items: center; display: none;">

            <!-- Pernos metálicos -->
            <ui:VisualElement class="bolt-tl" />
            <ui:VisualElement class="bolt-tr" />
            <ui:VisualElement class="bolt-bl" />
            <ui:VisualElement class="bolt-br" />

            <ui:Label text="INGRESA EL CÓDIGO" class="titulo-panel" />

            <ui:TextField name="input-codigo" class="input-campo"
                max-length="4"
                style="align-self: stretch;"
                placeholder="XXXX" />

            <ui:Label name="lbl-error-unirse" text=""
                class="texto-secundario"
                style="-unity-text-align: middle-center; color: #e57373; margin-bottom: 8px; display: none;" />

            <ui:Button name="btn-confirmar-unirse" text="UNIRSE →" class="btn btn-primario"
                style="align-self: stretch;" />
            <ui:Button name="btn-cancelar-unirse"  text="VOLVER"   class="btn btn-destructivo"
                style="align-self: stretch; margin-bottom: 0;" />

        </ui:VisualElement>

        <!-- Panel de espera en sala -->
        <ui:VisualElement name="panel-espera" class="tablero-menu"
            style="width: 440px; align-items: center; display: none;">

            <!-- Pernos metálicos -->
            <ui:VisualElement class="bolt-tl" />
            <ui:VisualElement class="bolt-tr" />
            <ui:VisualElement class="bolt-bl" />
            <ui:VisualElement class="bolt-br" />

            <ui:Label text="EN SALA" class="titulo-panel" style="margin-bottom: 8px;" />

            <ui:Label name="lbl-codigo-sala"        text="----" class="text-code"
                style="margin-bottom: 4px;" />
            <ui:Label name="lbl-contador-jugadores" text="0 / 4"
                class="label-categoria" style="margin-bottom: 20px;" />

            <ui:VisualElement name="lista-jugadores"
                class="grupo-contenido" style="align-self: stretch; margin-bottom: 20px;" />

            <ui:Button name="btn-iniciar-partida"   text="▶ INICIAR PARTIDA" class="btn btn-primario"
                style="align-self: stretch; display: none;" />

            <ui:Label name="lbl-aviso-minimo"       text="Se necesitan al menos 2 jugadores"
                style="margin-bottom: 12px; display: none;" />

            <ui:Button name="btn-abandonar-sala"    text="ABANDONAR SALA"   class="btn btn-destructivo"
                style="align-self: stretch; margin-bottom: 0;" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
