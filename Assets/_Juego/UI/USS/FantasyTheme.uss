/* ─── Paleta ───────────────────────────────────────────────────────── */
:root {
    --color-bg:          #0d0a14;
    --color-panel:       #1a1428;
    --color-panel-alt:   #221b38;
    --color-border:      #7a5c1e;
    --color-gold:        #c9952a;
    --color-gold-light:  #f0c060;
    --color-purple:      #6b3fa0;
    --color-purple-light:#9b6fe0;
    --color-text:        #e8dfc8;
    --color-text-dim:    #8a7f6a;
    --color-danger:      #8b2020;
    --color-success:     #2a6b3a;
    --color-white:       #ffffff;

    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 20px;

    --shadow-gold: 0 0 12px rgba(201,149,42,0.45);
    --shadow-panel: 0 4px 24px rgba(0,0,0,0.7);
}

/* ─── Root / Fondo ─────────────────────────────────────────────────── */
.root-container {
    width: 100%;
    height: 100%;
    background-color: var(--color-bg);
    align-items: center;
    justify-content: center;
}

/* ─── Panel base ───────────────────────────────────────────────────── */
.panel {
    background-color: var(--color-panel);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: 24px;
}

.panel--alt {
    background-color: var(--color-panel-alt);
}

/* ─── Título / Logo ────────────────────────────────────────────────── */
.title-logo {
    font-size: 52px;
    color: var(--color-gold-light);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 0 18px rgba(240,192,96,0.6);
    margin-bottom: 8px;
}

.title-subtitle {
    font-size: 18px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: 40px;
}

/* ─── Botones ──────────────────────────────────────────────────────── */
.btn {
    height: 52px;
    min-width: 220px;
    border-radius: var(--radius-md);
    border-width: 2px;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
    cursor: link;
    margin-bottom: 12px;
}

.btn--primary {
    background-color: var(--color-gold);
    border-color: var(--color-gold-light);
    color: #1a1000;
}

.btn--primary:hover {
    background-color: var(--color-gold-light);
    border-color: var(--color-white);
    scale: 1.04;
}

.btn--primary:active {
    scale: 0.97;
    background-color: var(--color-border);
}

.btn--secondary {
    background-color: var(--color-panel-alt);
    border-color: var(--color-purple);
    color: var(--color-purple-light);
}

.btn--secondary:hover {
    background-color: var(--color-purple);
    border-color: var(--color-purple-light);
    color: var(--color-white);
    scale: 1.04;
}

.btn--secondary:active {
    scale: 0.97;
}

.btn--danger {
    background-color: var(--color-danger);
    border-color: #c04040;
    color: var(--color-white);
}

.btn--danger:hover {
    background-color: #a83030;
    border-color: #e06060;
    scale: 1.04;
}

.btn--danger:active {
    scale: 0.97;
}

.btn--ghost {
    background-color: rgba(0,0,0,0);
    border-color: var(--color-border);
    color: var(--color-text-dim);
}

.btn--ghost:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
}

.btn:disabled {
    opacity: 0.4;
    cursor: arrow;
}

/* ─── Separador decorativo ─────────────────────────────────────────── */
.divider {
    height: 2px;
    background-color: var(--color-border);
    margin-top: 16px;
    margin-bottom: 16px;
    opacity: 0.4;
}

/* ─── Texto genérico ───────────────────────────────────────────────── */
.text-header {
    font-size: 24px;
    color: var(--color-gold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.text-body {
    font-size: 15px;
    color: var(--color-text);
    white-space: normal;
}

.text-dim {
    font-size: 13px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
}

.text-code {
    font-size: 28px;
    color: var(--color-gold-light);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
}

/* ─── Input field ──────────────────────────────────────────────────── */
.input-field {
    height: 48px;
    background-color: #0a0812;
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    color: var(--color-gold-light);
    font-size: 20px;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    padding: 0 16px;
    margin-bottom: 16px;
}

.input-field:focus {
    border-color: var(--color-gold-light);
}

/* ─── Badge / Indicador ────────────────────────────────────────────── */
.badge {
    background-color: var(--color-panel-alt);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-lg);
    padding: 4px 14px;
    font-size: 13px;
    color: var(--color-text-dim);
}

.badge--gold {
    background-color: rgba(201,149,42,0.15);
    border-color: var(--color-gold);
    color: var(--color-gold-light);
}

/* ─── Tarjeta de personaje ─────────────────────────────────────────── */
.char-card {
    width: 160px;
    height: 220px;
    background-color: var(--color-panel-alt);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 12px;
    margin: 8px;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.18s;
    cursor: link;
    overflow: hidden;
}

.char-card:hover {
    border-color: var(--color-gold);
    background-color: var(--color-panel);
    scale: 1.06;
}

.char-card--selected {
    border-color: var(--color-gold-light);
    background-color: rgba(201,149,42,0.12);
    scale: 1.08;
}

.char-name {
    font-size: 13px;
    color: var(--color-gold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(10,8,18,0.75);
    padding: 4px 8px;
    border-radius: 4px;
    width: 100%;
}

/* ─── Preview 3D / placeholder ─────────────────────────────────────── */
.char-preview {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.char-icon-placeholder {
    font-size: 56px;
    -unity-text-align: middle-center;
    color: var(--color-purple-light);
}

/* ─── Grid de personajes ───────────────────────────────────────────── */
.char-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    padding: 16px;
}

/* ─── HUD Energía ──────────────────────────────────────────────────── */
.hud-energy {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: rgba(13,10,20,0.85);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: 12px 16px;
    align-items: center;
    flex-direction: row;
}

.energy-icon {
    font-size: 22px;
    margin-right: 6px;
}

.energy-value {
    font-size: 22px;
    color: var(--color-gold-light);
    -unity-font-style: bold;
    min-width: 32px;
    -unity-text-align: middle-left;
}

.energy-label {
    font-size: 11px;
    color: var(--color-text-dim);
    -unity-text-align: middle-left;
    margin-left: 4px;
}

/* ─── Botón de energía pequeño ─────────────────────────────────────── */
.btn-energy {
    height: 40px;
    min-width: 140px;
    border-radius: var(--radius-sm);
    border-width: 2px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgba(107,63,160,0.3);
    border-color: var(--color-purple);
    color: var(--color-purple-light);
    margin-top: 6px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.btn-energy:hover {
    background-color: var(--color-purple);
    border-color: var(--color-purple-light);
    color: var(--color-white);
}

.btn-energy:disabled {
    opacity: 0.35;
}

/* ─── Panel carta revelada ─────────────────────────────────────────── */
.card-reveal-panel {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 280px;
    background-color: var(--color-panel);
    border-color: var(--color-gold);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: 20px;
    align-items: center;
}

.card-title-text {
    font-size: 18px;
    color: var(--color-gold-light);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.card-desc-text {
    font-size: 14px;
    color: var(--color-text);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 16px;
}

/* ─── Hand de cartas ───────────────────────────────────────────────── */
.hand-container {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    padding: 8px;
    background-color: rgba(13,10,20,0.7);
    border-top-width: 2px;
    border-color: var(--color-border);
}

.card-thumb {
    width: 60px;
    height: 90px;
    border-radius: var(--radius-sm);
    border-width: 2px;
    border-color: var(--color-border);
    margin: 4px;
    background-color: var(--color-panel-alt);
    align-items: center;
    justify-content: center;
    transition-property: scale, border-color;
    transition-duration: 0.12s;
    cursor: link;
}

.card-thumb:hover {
    scale: 1.1;
    border-color: var(--color-gold);
}

.card-thumb--reserve {
    opacity: 0.5;
}

/* ─── Panel selección ficha ────────────────────────────────────────── */
.ficha-panel {
    position: absolute;
    bottom: 120px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    background-color: rgba(26,20,40,0.92);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: 12px 20px;
    align-items: center;
}

/* ─── Lobby Photon ─────────────────────────────────────────────────── */
.lobby-container {
    width: 440px;
    align-items: center;
}

.players-indicator {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.player-dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: var(--color-panel-alt);
    border-color: var(--color-border);
    border-width: 2px;
    margin: 3px;
}

.player-dot--active {
    background-color: var(--color-gold);
    border-color: var(--color-gold-light);
}

/* ─── Selection indicator ──────────────────────────────────────────── */
.selection-status {
    font-size: 14px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    margin-top: 12px;
}

.selection-status--ready {
    color: var(--color-gold-light);
}

/* ─── Tarjeta modo lista (selección de personaje) ──────────────────── */
.char-card--list {
    width: 176px;
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 0 12px;
    margin: 4px 0;
    border-radius: var(--radius-sm);
}

.char-card--list .char-icon-placeholder {
    font-size: 28px;
    margin-right: 10px;
    flex-shrink: 0;
}

.char-card--list .char-name {
    font-size: 14px;
    background-color: rgba(0,0,0,0);
    padding: 0;
    width: auto;
    -unity-text-align: middle-left;
}

/* ─── Badge de color de jugador ────────────────────────────────────── */
.player-color-badge {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255,255,255,0.3);
    background-color: #888888;
}

.player-color-badge--rojo    { background-color: #c0392b; border-color: #e74c3c; }
.player-color-badge--azul    { background-color: #2471a3; border-color: #5dade2; }
.player-color-badge--verde   { background-color: #1e8449; border-color: #52be80; }
.player-color-badge--amarillo{ background-color: #b7950b; border-color: #f4d03f; }

/* Puntos de jugadores con color propio */
.player-dot--rojo    { background-color: #c0392b; border-color: #e74c3c; }
.player-dot--azul    { background-color: #2471a3; border-color: #5dade2; }
.player-dot--verde   { background-color: #1e8449; border-color: #52be80; }
.player-dot--amarillo{ background-color: #b7950b; border-color: #f4d03f; }

/* ═══════════════════════════════════════════════════════════════════
   PANTALLA SELECCIÓN DE PERSONAJES
   Layout columnar: header | viewport(flex-grow) | char-strip | footer
   ═══════════════════════════════════════════════════════════════════ */

/* Raíz: columna de alto completo */
.seleccion-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--color-bg);
}

/* ─── Header ──────────────────────────────────────────────────────── */
.seleccion-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    background-color: var(--color-panel);
    border-bottom-width: 2px;
    border-color: var(--color-border);
    flex-shrink: 0;
}

.seleccion-btn-volver {
    min-width: 110px;
    height: 38px;
    font-size: 13px;
    margin-bottom: 0;
}

.seleccion-titulo {
    flex-grow: 1;
    font-size: 20px;
    margin-bottom: 0;
}

.seleccion-status-wrap {
    align-items: flex-end;
    min-width: 130px;
}

.seleccion-color-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.seleccion-lbl-color {
    font-size: 11px;
    margin-left: 6px;
}

.seleccion-lbl-jugadores {
    font-size: 12px;
}

/* ─── Viewport 3D ─────────────────────────────────────────────────── */
.seleccion-viewport-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    /* posición relativa para que los hijos absolutos se anclen aquí */
    position: relative;
    background-color: #080610;
    overflow: hidden;
}

/* Superficie que recibe el backgroundImage de la RenderTexture */
.seleccion-render-display {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* Fix Causa E: dimensión mínima para que el rect no sea cero cuando
       el viewport-wrap aún no resolvió su flex-grow en el primer frame */
    min-height: 300px;
    /* Color de diagnóstico: si aparece este gris el RT llegó al elemento
       pero el render está vacío; si no aparece nada el elemento mismo es cero */
    background-color: rgba(0, 0, 0, 0.5);
    -unity-background-scale-mode: scale-to-fit;
}

/* Overlay del nombre del personaje, pegado al fondo del viewport */
.seleccion-nombre-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(13,10,20,0.72);
    padding: 10px 16px;
    align-items: center;
}


/* ─── Selector horizontal de personajes (cartas imagen) ──────────── */
.seleccion-char-strip {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: var(--color-panel);
    border-top-width: 2px;
    border-color: var(--color-border);
    padding: 10px 16px;
    flex-shrink: 0;
    height: 210px;
}

/* Carta individual: imagen de fondo, proporción vertical ~0.65 */
.char-chip {
    width: 117px;
    height: 180px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    border-color: var(--color-border);
    border-width: 3px;
    border-radius: var(--radius-sm);
    margin: 0 8px;
    cursor: link;
    opacity: 0.7;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: opacity, border-color, scale;
    transition-duration: 0.15s;
}

.char-chip:hover {
    opacity: 0.9;
    border-color: var(--color-gold);
    scale: 1.04;
}

.char-chip--selected {
    opacity: 1;
    border-color: var(--color-gold-light);
    border-width: 3px;
    scale: 1.06;
}

.chip-icon {
    display: none;
}

.chip-name {
    font-size: 10px;
    color: var(--color-gold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    background-color: rgba(10,8,18,0.82);
    padding: 3px 6px;
    width: 100%;
}

/* ─── Footer ──────────────────────────────────────────────────────── */
.seleccion-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    background-color: var(--color-panel);
    border-top-width: 2px;
    border-color: var(--color-border);
    flex-shrink: 0;
}

.seleccion-btn-confirmar {
    min-width: 240px;
    margin-bottom: 0;
}
