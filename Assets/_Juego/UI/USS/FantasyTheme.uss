/* ─── Paleta — Tablero de Madera ───────────────────────────────────── */
:root {
    --wood-light:    #8d6e63;
    --wood-medium:   #5d4037;
    --wood-dark:     #3e2723;
    --wood-deepest:  #2b1d1a;
    --metal-bolt:    #90a4ae;
    --metal-dark:    #546e7a;
    --accent-green:  #2e7d32;
    --accent-green-dark: #1b5e20;
    --accent-blue:   #0277bd;
    --text-primary:  #efebe9;
    --text-secondary:#d7ccc8;
    --text-muted:    #b0bec5;
    --bg-root:       #1a1a1a;
}

/* ─── Root / Fondo ─────────────────────────────────────────────────── */
.root-container {
    width: 100%;
    height: 100%;
    background-color: var(--bg-root);
    align-items: center;
    justify-content: center;
}

/* ─── Tablero (contenedor principal — efecto madera 3D) ────────────── */
.tablero,
.board {
    background-color: var(--wood-medium);
    border-color: var(--wood-dark);
    border-width: 8px;
    border-bottom-width: 16px;
    border-radius: 12px;
    padding: 40px;
    position: relative;
}

/* ─── Tablero menú principal (imagen de madera) ─────────────────────── */
.tablero-menu {
    background-image: resource("menu");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 12px;
    padding: 40px;
    position: relative;
}

/* ─── Pernos metálicos (4 esquinas) ───────────────────────────────── */
.bolt-tl,
.bolt-tr,
.bolt-bl,
.bolt-br {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: var(--metal-bolt);
}

.bolt-tl { top: 10px;    left: 10px;  }
.bolt-tr { top: 10px;    right: 10px; }
.bolt-bl { bottom: 10px; left: 10px;  }
.bolt-br { bottom: 10px; right: 10px; }

/* ─── Tipografía ───────────────────────────────────────────────────── */
.titulo-juego {
    font-size: 36px;
    color: #ffffff;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-transform: uppercase;
    margin-bottom: 30px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.9);
}

.titulo-panel {
    font-size: 24px;
    color: #ffffff;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-transform: uppercase;
    margin-bottom: 30px;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.9);
}

.texto-normal {
    font-size: 14px;
    color: #ffffff;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
}

.texto-secundario {
    font-size: 12px;
    color: #e0d5c5;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
}

.label-categoria {
    font-size: 12px;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 2px;
    background-color: rgba(0,0,0,0.5);
    padding: 4px 12px;
    border-radius: 10px;
}

/* ─── Botones ──────────────────────────────────────────────────────── */
.btn {
    background-color: #3e2723;
    color: #ffffff;
    border-color: #2b1d1a;
    border-width: 2px;
    border-radius: 4px;
    padding: 15px 35px;
    font-size: 16px;
    -unity-font-style: bold;
    min-width: 200px;
    margin-bottom: 12px;
    cursor: link;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.btn:hover {
    color: #ffffff;
    background-color: #4e342e;
}

.btn:active {
    background-color: #2b1d1a;
    translate: 0 2px;
}

.btn:disabled {
    background-color: #1a1210;
    color: #5d4037;
    opacity: 0.6;
    cursor: arrow;
}

/* Variante primaria (confirmar, iniciar, jugar) — verde */
.btn-primario {
    background-color: #2e7d32;
    color: #ffffff;
    border-color: #1b5e20;
}

.btn-primario:hover {
    background-color: #388e3c;
    color: #ffffff;
}

.btn-primario:active {
    background-color: #1b5e20;
    translate: 0 2px;
}

/* Variante destructiva (abandonar, salir) */
.btn-destructivo {
    background-color: #b71c1c;
    color: #ffffff;
    border-color: #7f0000;
}

.btn-destructivo:hover {
    color: #ffffff;
    background-color: #c62828;
}

/* ─── Inputs ───────────────────────────────────────────────────────── */
.input-campo {
    background-color: rgba(0,0,0,0.5);
    border-color: rgba(255,255,255,0.2);
    border-width: 1px;
    border-radius: 4px;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 10px;
    margin-bottom: 16px;
}

.input-campo:focus {
    border-color: rgba(255,255,255,0.5);
}

.input-campo > #unity-text-input {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 0;
    color: #ffffff;
}

/* ─── Grupos de contenido ──────────────────────────────────────────── */
.grupo-contenido {
    background-color: rgba(0,0,0,0.35);
    border-color: rgba(0,0,0,0.4);
    border-width: 1px;
    border-radius: 8px;
    padding: 10px;
}

/* ─── Slots de jugadores (lobby) ───────────────────────────────────── */
.jugador-slot {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 6px 12px;
    margin: 3px 0;
    border-radius: 6px;
    background-color: rgba(0,0,0,0.55);
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    height: 36px;
}

.jugador-activo {
    -unity-text-align: middle-left;
    color: rgb(255, 235, 180);
    font-size: 15px;
    margin: 0;
    padding: 0;
}

.jugador-vacio {
    -unity-text-align: middle-left;
    color: rgba(255,255,255,0.45);
    font-size: 14px;
    margin: 0;
    padding: 0;
}

/* ─── Fondo de aventura ────────────────────────────────────────────── */
.fondo-aventura {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-image: resource("fondo");
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.fondo-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0,0,0,0.45);
}

.franja-superior {
    height: 4px;
    min-height: 4px;
    max-height: 4px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(0,0,0,0);
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
}

.franja-inferior {
    height: 4px;
    min-height: 4px;
    max-height: 4px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(0,0,0,0);
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
}

/* ─── Visibilidad de paneles ───────────────────────────────────────── */
.panel-activo  { display: flex; }
.panel-oculto  { display: none; }

/* ─── Overlay de aviso ─────────────────────────────────────────────── */
.overlay-aviso {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0,0,0,0.75);
    align-items: center;
    justify-content: center;
}

/* ─── Fondo específico de selección de personajes ──────────────────── */
.fondo-seleccion {
    background-image: resource("seleccion");
    -unity-background-scale-mode: scale-and-crop;
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

/* ─── Barra decorativa de madera ───────────────────────────────────── */
.barra-madera {
    background-image: resource("laterales");
    -unity-background-scale-mode: stretch-to-fill;
    border-radius: 6px;
    overflow: hidden;
}

/* ═══════════════════════════════════════════════════════════════════
   PANTALLA SELECCIÓN DE PERSONAJES
   Layout columnar: header | viewport(flex-grow) | char-strip | footer
   ═══════════════════════════════════════════════════════════════════ */

.seleccion-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-image: resource("seleccion");
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(0,0,0,0);
}

/* ─── Header ──────────────────────────────────────────────────────── */
.seleccion-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    background-color: var(--wood-dark);
    border-bottom-width: 2px;
    border-color: var(--wood-deepest);
    flex-shrink: 0;
}

.seleccion-btn-volver {
    min-width: 110px;
    height: 38px;
    font-size: 13px;
    margin-bottom: 0;
    padding: 6px 16px;
}

.seleccion-titulo {
    flex-grow: 1;
    font-size: 20px;
    margin-bottom: 0;
}

.seleccion-status-wrap {
    align-items: flex-end;
    min-width: 130px;
}

.seleccion-color-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.seleccion-lbl-color {
    font-size: 11px;
    margin-left: 6px;
    color: var(--text-muted);
}

.seleccion-lbl-jugadores {
    font-size: 12px;
    color: var(--text-muted);
}

/* ─── Viewport 3D ─────────────────────────────────────────────────── */
.seleccion-viewport-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    position: relative;
    background-color: rgba(0,0,0,0);
    overflow: hidden;
}

.seleccion-render-display {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 300px;
    background-color: rgba(0,0,0,0);
    border-color: rgba(255,255,255,0.1);
    -unity-background-scale-mode: scale-to-fit;
}

#render-texture-display {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}

.seleccion-nombre-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(13,10,20,0.72);
    padding: 10px 16px;
    align-items: center;
}

/* ─── Selector horizontal de personajes (cartas imagen) ───────────── */
.seleccion-char-strip {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: var(--wood-dark);
    border-top-width: 2px;
    border-color: var(--wood-deepest);
    padding: 10px 16px;
    flex-shrink: 0;
    height: 210px;
}

/* Contenedor de cada chip: lleva la imagen de laterales */
.chip-contenedor {
    background-image: resource("laterales");
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
    border-radius: 6px;
    padding: 4px;
    margin: 4px 8px;
}

.char-chip {
    width: 117px;
    height: 180px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    border-color: var(--wood-medium);
    border-width: 3px;
    border-radius: 6px;
    margin: 0;
    cursor: link;
    opacity: 0.7;
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: opacity, border-color, scale;
    transition-duration: 0.15s;
}

.char-chip:hover {
    opacity: 0.9;
    border-color: var(--wood-light);
    scale: 1.04;
}

.char-chip--selected {
    opacity: 1;
    border-color: var(--text-secondary);
    border-width: 3px;
    scale: 1.06;
}

.chip-icon {
    display: none;
}

.chip-name {
    font-size: 10px;
    color: var(--wood-light);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    background-color: rgba(10,8,18,0.82);
    padding: 3px 6px;
    width: 100%;
}

/* ─── Footer ──────────────────────────────────────────────────────── */
.seleccion-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    background-color: var(--wood-dark);
    border-top-width: 2px;
    border-color: var(--wood-deepest);
    flex-shrink: 0;
}

.seleccion-btn-confirmar {
    min-width: 240px;
    margin-bottom: 0;
}

/* ─── Indicadores de jugadores ─────────────────────────────────────── */
.players-indicator {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.player-dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: var(--wood-dark);
    border-color: var(--wood-medium);
    border-width: 2px;
    margin: 3px;
}

.player-dot--active {
    background-color: #ffd964;
    border-color: #fff8dc;
}

/* ─── Badge de color de jugador ────────────────────────────────────── */
.player-color-badge {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255,255,255,0.3);
    background-color: #888888;
}

.player-color-badge--rojo    { background-color: #c0392b; border-color: #e74c3c; }
.player-color-badge--azul    { background-color: #2471a3; border-color: #5dade2; }
.player-color-badge--verde   { background-color: #1e8449; border-color: #52be80; }
.player-color-badge--amarillo{ background-color: #b7950b; border-color: #f4d03f; }

.player-dot--rojo    { background-color: #c0392b; border-color: #e74c3c; }
.player-dot--azul    { background-color: #2471a3; border-color: #5dade2; }
.player-dot--verde   { background-color: #1e8449; border-color: #52be80; }
.player-dot--amarillo{ background-color: #b7950b; border-color: #f4d03f; }

/* ─── Aviso mínimo jugadores ───────────────────────────────────────── */
#lbl-aviso-minimo {
    color: rgba(255, 180, 80, 0.8);
    font-size: 12px;
    -unity-text-align: middle-center;
}

/* ─── Texto código sala ────────────────────────────────────────────── */
.text-code {
    font-size: 28px;
    color: var(--text-secondary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
}

/* ─── Texto de estado de selección ────────────────────────────────── */
.selection-status {
    font-size: 14px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
    margin-top: 12px;
}

.selection-status--ready {
    color: var(--text-secondary);
}

/* ─── HUD Energía ──────────────────────────────────────────────────── */
.hud-energy {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: rgba(26,26,26,0.85);
    border-color: var(--wood-dark);
    border-width: 2px;
    border-radius: 12px;
    padding: 12px 16px;
    align-items: center;
    flex-direction: row;
}

.energy-icon {
    font-size: 22px;
    margin-right: 6px;
}

.energy-value {
    font-size: 22px;
    color: var(--text-secondary);
    -unity-font-style: bold;
    min-width: 32px;
    -unity-text-align: middle-left;
}

.energy-label {
    font-size: 11px;
    color: var(--text-muted);
    -unity-text-align: middle-left;
    margin-left: 4px;
}

/* ─── Botón de energía pequeño ─────────────────────────────────────── */
.btn-energy {
    height: 40px;
    min-width: 140px;
    border-radius: 6px;
    border-width: 2px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgba(0,119,189,0.3);
    border-color: var(--accent-blue);
    color: #81d4fa;
    margin-top: 6px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.btn-energy:hover {
    background-color: var(--accent-blue);
    border-color: #81d4fa;
    color: var(--text-primary);
}

.btn-energy:disabled {
    opacity: 0.35;
}

/* ─── Panel carta revelada ─────────────────────────────────────────── */
.card-reveal-panel {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 280px;
    background-color: var(--wood-medium);
    border-color: var(--wood-light);
    border-width: 2px;
    border-radius: 12px;
    padding: 20px;
    align-items: center;
}

.card-title-text {
    font-size: 18px;
    color: var(--text-secondary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.card-desc-text {
    font-size: 14px;
    color: var(--text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 16px;
}

/* ─── Hand de cartas ───────────────────────────────────────────────── */
.hand-container {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    padding: 8px;
    background-color: rgba(26,26,26,0.7);
    border-top-width: 2px;
    border-color: var(--wood-dark);
}

.card-thumb {
    width: 60px;
    height: 90px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--wood-dark);
    margin: 4px;
    background-color: var(--wood-medium);
    align-items: center;
    justify-content: center;
    transition-property: scale, border-color;
    transition-duration: 0.12s;
    cursor: link;
}

.card-thumb:hover {
    scale: 1.1;
    border-color: var(--wood-light);
}

.card-thumb--reserve {
    opacity: 0.5;
}

/* ─── Panel selección ficha ────────────────────────────────────────── */
.ficha-panel {
    position: absolute;
    bottom: 120px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    background-color: rgba(26,26,26,0.92);
    border-color: var(--wood-dark);
    border-width: 2px;
    border-radius: 12px;
    padding: 12px 20px;
    align-items: center;
}
